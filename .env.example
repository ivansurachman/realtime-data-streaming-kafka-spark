# Salin ke .env:  cp .env.example .env
# Dibaca oleh: docker compose (substitusi + env_file spark) dan producer (python-dotenv).
# Tidak ada secret di sini (Kafka PLAINTEXT lokal).

# --- Logging (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# --- Kafka
KAFKA_IMAGE=apache/kafka:3.8.1
# port Kafka di host
KAFKA_HOST_PORT=9092
# untuk producer (host); port harus sama dengan KAFKA_HOST_PORT
KAFKA_BOOTSTRAP_HOST=localhost:9092
# untuk spark (antar container); jangan diubah
KAFKA_BOOTSTRAP_INTERNAL=kafka:29092

# --- Kafbat UI (monitoring)
KAFBAT_IMAGE=ghcr.io/kafbat/kafka-ui:v1.3.0
KAFBAT_UI_PORT=8080

# --- Topic
TOPIC_RAW=transactions
TOPIC_VALID=transactions_valid
TOPIC_DLQ=transactions_dlq

# --- Streaming job
WATERMARK_MINUTES=3
WINDOW_MINUTES=1
AMOUNT_MIN=1
AMOUNT_MAX=10000000
VALID_SOURCES=mobile,web,pos

# --- Producer
PRODUCER_COUNT=60
